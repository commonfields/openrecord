DATABASE_URL=postgres://openrecord:openrecord@localhost:5432/openrecord
SESSION_SECRET=change-me-32-bytes-minimum
APP_BASE_URL=http://localhost:3000
PORT=3001
# Hosted external provider is opt-in; enabling it requires a key and model.
NINE_ROUTER_ENABLED=false
# NINE_ROUTER_BASE_URL=http://localhost:20128/v1
# NINE_ROUTER_API_KEY=
# NINE_ROUTER_MODELS=provider/model-a,provider/model-b
# Temporary single-model compatibility path:
# NINE_ROUTER_MODEL=provider/model-a
# NINE_ROUTER_TIMEOUT_MS=60000
PROVIDER_RESPONSE_MAX_BYTES=2097152
# Client record live surface: Gemini API with Google Search grounding.
# The worker needs the key; the API reads GEMINI_MODEL to request it.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_MS=60000
# Local walkthrough only (synthetic answers, never verifiable):
# RECORD_PROVIDER=mock
# RECORD_ALLOW_FIXTURE=1
# Private internal assistant: separate from measurement provider configuration.
# Enable only after authorizing external processing of client evidence.
AGENT_EXTERNAL_PROCESSING_ENABLED=false
# AGENT_PROVIDER=gemini      # or cliproxy: a CLIProxyAPI server this host can reach
# AGENT_MODEL=
# AGENT_API_KEY=              # cliproxy: one of its access api-keys
# AGENT_BASE_URL=http://127.0.0.1:8317   # cliproxy only; plain HTTP only on loopback
# AGENT_MAX_OUTPUT_TOKENS=2048
# AGENT_TIMEOUT_MS=20000
# Agent web access. Reading public pages and site audits work without a key,
# through the SSRF-safe fetcher with robots.txt honoured. With a context.dev key
# the agent can also search the web and read pages built with JavaScript; only
# the URL or query is sent to context.dev.
# CONTEXT_DEV_API_KEY=
# Optional server-only PageSpeed Insights key. Enables measure_web_performance;
# it sends public page URLs to Google and returns Lighthouse lab measurements.
# PAGESPEED_API_KEY=
# Optional acquisition proposal estimate per provider attempt, including grounding.
# Missing pricing blocks approval. This is a deployment-supplied bound, not a quote.
# AGENT_MEASUREMENT_MAX_USD_PER_ATTEMPT=
# W8 read-only Google Analytics 4 measurement (API and worker). All four are
# required; without them the GA4 connection is reported as not configured.
# The redirect URI must be exactly <APP_BASE_URL>/api/growth/ga4/oauth/callback
# and registered on the Google OAuth client. Keys: comma-separated id:base64(32 bytes),
# newest first; older keys only decrypt (rotation). Generate: openssl rand -base64 32
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GA4_OAUTH_REDIRECT_URI=http://localhost:3000/api/growth/ga4/oauth/callback
# GA4_TOKEN_ENCRYPTION_KEYS=k1:

# Ad accounts (Meta and Google Ads), read-only. See docs/operations/connect-ad-accounts.md.
# One callback for both platforms; register it with Meta and with the Google client.
# ADS_OAUTH_REDIRECT_URI=http://localhost:3000/api/ads/oauth/callback
# Optional: defaults to GA4_TOKEN_ENCRYPTION_KEYS.
# ADS_TOKEN_ENCRYPTION_KEYS=k1:
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_VERSION=v23.0
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_API_VERSION=v21
# GA4_SYNC_INTERVAL_HOURS=24
# GA4_REFRESH_DAYS=3

# Run the bridge on this computer for whoever signs in, with no pairing code,
# and turn on the signed-in local CLIs (Codex, Claude Code, OpenCode, Cursor,
# CLIProxyAPI). Only for the desktop app or a single-user local server.
# OPENRECORD_LOCAL_BRIDGE=1
# OPENRECORD_BRIDGE_SCRIPT=   # the bridge program; defaults to this checkout's source
