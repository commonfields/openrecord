{
  "name": "@openrecord/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint app tests --max-warnings 0",
    "test": "vitest run",
    "build": "pnpm --filter @openrecord/bridge build && vite build",
    "dev": "pnpm --filter @openrecord/bridge build && vite --port 3000"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@openrecord/contracts": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.49.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "7.0.2",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^16.34.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@openrecord/bridge": "workspace:*",
    "@openrecord/domain": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "4.3.4",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
