# OpenRecord hosted pilot — optional provider credentials.
#
# Copy to deploy/provider.env ONLY when you want an integration enabled.
# Every key here is a secret: this file is git-ignored and is read by the api
# and worker containers. An absent file (the default) means all provider
# integrations stay safely disabled and provider-backed features answer
# honestly that they are unavailable.
#
# NOTE: never set a variable to an empty value here — an empty key is invalid
# configuration and stops the worker. Omit the line instead.

# Client record live surface (Gemini API with Google Search grounding).
#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-2.5-flash

# Connected execution (W7): fine-grained GitHub token limited to the pilot's
# own disposable repositories. Format: owner/repo=<account id>,...
#GITHUB_EXECUTION_TOKEN=
#GITHUB_EXECUTION_REPOSITORIES=

# Google Analytics 4 (W8): all four are required together; with any missing
# the GA4 connection reports as not configured.
#GOOGLE_OAUTH_CLIENT_ID=
#GOOGLE_OAUTH_CLIENT_SECRET=
#GA4_OAUTH_REDIRECT_URI=https://pilot.example.com/api/growth/ga4/oauth/callback
#GA4_TOKEN_ENCRYPTION_KEYS=

# External 9Router (checks/assay provider).
#NINE_ROUTER_ENABLED=true
#NINE_ROUTER_BASE_URL=
#NINE_ROUTER_API_KEY=
#NINE_ROUTER_MODELS=
