# OpenRecord hosted pilot — copy to deploy/.env and fill in.
# deploy/.env is git-ignored: it carries the secrets, never commit it.

# --- database (required) -------------------------------------------------
# Used only on the private compose network; PostgreSQL publishes no ports.
POSTGRES_USER=openrecord
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=change-me-random-long-password
POSTGRES_DB=openrecord

# --- application origin (required) --------------------------------------
# Exactly the origin a browser uses, scheme included. Local pilot default:
APP_BASE_URL=http://localhost:8080
# Public pilot: APP_BASE_URL=https://pilot.example.com

# --- reverse proxy -------------------------------------------------------
# Local pilot (default): plain HTTP on the mapped port below.
PILOT_SITE=:80
PILOT_AUTO_HTTPS=off
PILOT_HTTP_PORT=8080
# Public pilot: PILOT_SITE=pilot.example.com, PILOT_AUTO_HTTPS=on, and map
# PILOT_HTTP_PORT=80 plus PILOT_HTTPS_PORT=443 in compose (or edit the ports
# block) so Caddy can complete the ACME challenge. APP_BASE_URL must then be
# the https origin.
#PILOT_SITE=pilot.example.com
#PILOT_AUTO_HTTPS=on
#PILOT_HTTP_PORT=80
#PILOT_HTTPS_PORT=443

# --- version identification (recommended) --------------------------------
# Set by deploy/hosted-pilot-release.sh or manually to the deployed commit.
#OPENRECORD_BUILD_COMMIT=

# --- external providers (optional; see deploy/provider.env.example) -------
# Provider credentials are injected ONLY through the optional, git-ignored
# deploy/provider.env. With no file present, every provider integration stays
# safely disabled. Never set a provider key to an empty value.

