{
  "name": "@openrecord/db",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migrate": "./src/migrate.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@effect/sql": "0.52.1",
    "@effect/sql-pg": "0.53.0",
    "@openrecord/contracts": "workspace:*",
    "@openrecord/domain": "workspace:*",
    "@openrecord/protocol": "workspace:*",
    "@openrecord/representation": "workspace:*",
    "@openrecord/truth": "workspace:*",
    "effect": "3.22.2",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.11.0",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
